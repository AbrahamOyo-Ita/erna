# Public address used by the Customer Care form to prepare an email request.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-your-ga4-measurement-id

# Supabase Project Settings > API Keys. Publishable keys are safe for browser use with RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Supabase key. Never prefix this variable with NEXT_PUBLIC_ and
# never expose it to a browser bundle.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Paystack server credentials and monthly plan codes. Use test-mode values in
# non-production environments and live-mode values only on the production host.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret
PAYSTACK_PLUS_PLAN_CODE=PLN_your-plus-plan
PAYSTACK_PRO_PLAN_CODE=PLN_your-pro-plan

# Transactional email outbox delivery through Resend. The From address must use
# a domain verified in the Resend account.
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=Erna <updates@your-verified-domain.example>
CRON_SECRET=generate-a-long-random-secret

# OpenWA runs as a separate self-hosted service. This unofficial channel is
# opt-in and restricted to non-financial product notifications.
OPENWA_ENABLED=false
OPENWA_BASE_URL=https://your-private-openwa-host.example
OPENWA_API_KEY=owa_k1_your-session-scoped-operator-key
OPENWA_SESSION_ID=your-openwa-session-id
OPENWA_SENDER_NUMBER=08162851706
OPENWA_WEBHOOK_SECRET=generate-a-separate-long-random-secret

# Google AdSense placements. Pro is suppressed server-side, Plus receives the
# wallet/marketplace placements, and Free also receives the task-feed placement.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-publisher-id
NEXT_PUBLIC_AD_TASK_FEED_SLOT=your-task-feed-slot
NEXT_PUBLIC_AD_WALLET_SLOT=your-wallet-slot
NEXT_PUBLIC_AD_MARKETPLACE_SLOT=your-marketplace-slot

# Optional until CAPTCHA is enabled in Supabase. Add the public hCaptcha site key first,
# then enable hCaptcha in Auth > Bot and Abuse Protection with the matching secret key.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Configure Supabase Auth URL settings with your production origin and these paths:
# /auth/callback, /reset-password, /app
# Enable the Google provider in Supabase Auth and add Supabase's callback URL
# to the authorized redirect URIs in Google Cloud Console.
